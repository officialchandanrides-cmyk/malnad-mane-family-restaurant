*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#f8f8f8;
    color:#333;
}

header{
    background:#0b5d1e;
    color:#fff;
    text-align:center;
    padding:20px;
}

header h1{
    font-size:32px;
}

header p{
    margin:10px 0;
}

button{
    padding:12px 20px;
    margin:8px;
    border:none;
    border-radius:8px;
    cursor:pointer;
    font-size:16px;
    font-weight:bold;
}

.veg{
    background:#2e7d32;
    color:#fff;
}

.nonveg{
    background:#c62828;
    color:#fff;
}

.hero{
    text-align:center;
    padding:40px 20px;
}

.hero h2{
    margin-bottom:20px;
}

.special{
    padding:20px;
}

.special h2{
    text-align:center;
    margin-bottom:20px;
}

.card{
    background:#fff;
    border-radius:12px;
    padding:20px;
    margin:15px auto;
    width:90%;
    max-width:400px;
    box-shadow:0 2px 10px rgba(0,0,0,.15);
    text-align:center;
}

.card h3{
    color:#0b5d1e;
}

footer{
    background:#0b5d1e;
    color:#fff;
    text-align:center;
    padding:20px;
    margin-top:30px;
}

@media(max-width:768px){
    header h1{
        font-size:24px;
    }

    button{
        width:90%;
    }
}
